@article{neumaierEvaluationFlickerInduced2021,
  title = {Evaluation of Flicker-Induced Retinal Vessel Response in Cav2.3-Deficient Mice Using Dynamic Retinal Vessel Analysis},
  author = {Neumaier, Felix and Kotliar, Konstantin and Haeren, Roel Hubertus Louis and Temel, Yasin and L{\"u}ke, Jan Niklas and Seyam, Osama and Lindauer, Ute and Clusmann, Hans and Hescheler, J{\"u}rgen and Schubert, Gerrit Alexander and Schneider, Toni and Albanna, Walid},
