@article{fialovaPolarizationPropertiesSingle2016,
  title = {Polarization Properties of Single Layers in the Posterior Eyes of Mice and Rats Investigated Using High Resolution Polarization Sensitive Optical Coherence Tomography},
  author = {Fialov{\'a}, Stanislava and Augustin, Marco and Gl{\"o}smann, Martin and Himmel, Tanja and Rauscher, Sabine and Gr{\"o}ger, Marion and Pircher, Michael and Hitzenberger, Christoph K and Baumann, Bernhard},
  year = 2016,
  journal = {Biomedical Optics Express},
  volume = {7},
  number = {4},
  pages = {1479--1495},
  publisher = {OSA},
  doi = {10.1364/BOE.7.001479},
  abstract = {We present a high resolution polarization sensitive optical coherence tomography (PS-OCT) system for ocular imaging in rodents. The system operates at 840 nm and uses a broadband superluminescent diode providing an axial resolution of 5.1 \&\#x00B5;m in air. PS-OCT data was acquired at 83 kHz A-scan rate by two identical custom-made spectrometers for orthogonal polarization states. Pigmented (Brown Norway, Long Evans) and non-pigmented (Sprague Dawley) rats as well as pigmented mice (C57BL/6) were imaged. Melanin pigment related depolarization was analyzed in the retinal pigment epithelium (RPE) and choroid of these animals using the degree of polarization uniformity (DOPU). For all rat strains, significant differences between RPE and choroidal depolarization were observed. In contrast, DOPU characteristics of RPE and choroid were similar for C57BL/6 mice. Moreover, the depolarization within the same tissue type varied significantly between different rodent strains. Retinal nerve fiber layer thickness, phase retardation, and birefringence were mapped and quantitatively measured in Long Evans rats in vivo for the first time. In a circumpapillary annulus, retinal nerve fiber layer birefringence amounted to 0.16\&\#x00B0;/\&\#x00B5;m \&\#x00B1; 0.02\&\#x00B0;/\&\#x00B5;m and 0.17\&\#x00B0;/\&\#x00B5;m \&\#x00B1; 0.01\&\#x00B0;/\&\#x00B5;m for the left and right eyes, respectively.},
  keywords = {Birefringence,Image quality,Imaging systems,Imaging techniques,Optic nerve,Optical coherence tomography,Optical imaging,Polarization maintaining fibers,Polarization-selective devices,Tissue characterization}
}

